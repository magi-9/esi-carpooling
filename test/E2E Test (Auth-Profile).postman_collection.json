    {
      "name": "Cleanup",
      "description": "Logout and token cleanup",
      "item": [
        {
          "name": "Logout User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "// Clean up variables after the entire E2E run is complete",
                  "pm.collectionVariables.unset(\"jwt_token\");",
                  "pm.collectionVariables.unset(\"userId\");",
                  "pm.collectionVariables.unset(\"test_email\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "url": {
              "raw": "{{authBaseUrl}}/api/auth/logout",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
