    },
    {
      "name": "Profile Service",
      "description": "Profile endpoints testing the asynchronous Kafka creation and subsequent updates.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{jwt_token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "1. Get Auto-Created Profile (Kafka Wait)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Force Postman to wait 3 seconds to give Kafka time to create the profile",
                  "console.log(\"Waiting 3 seconds for Kafka to process the registration event...\");",
                  "pm.sendRequest('https://postman-echo.com/delay/3', function (err, response) {",
                  "    console.log(\"Wake up! Checking if Profile exists now...\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{profileBaseUrl}}/profiles/{{userId}}",
              "host": [
                "{{profileBaseUrl}}"
              ],
              "path": [
                "profiles",
                "{{userId}}"
              ]
            }
          }
        },
        {
          "name": "2. Attempt Duplicate Profile Creation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Verify duplicate profile creation is rejected\", function () {",
                  "    // We expect the server to throw an error (400 Bad Request, 409 Conflict, or 500 Server Error)",
                  "    // It absolutely should NOT return a 200 or 201 created status.",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 409, 500]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"userId\": \"{{userId}}\",\n    \"firstName\": \"Duplicate\",\n    \"lastName\": \"Test\",\n    \"phoneNumber\": \"+4911111111\"\n}"
            },
            "url": {
              "raw": "{{profileBaseUrl}}/profiles",
              "host": [
                "{{profileBaseUrl}}"
              ],
              "path": [
                "profiles"
              ]
            }
          }
        },
