{
  "info": {
    "name": "ESI Profile Service API",
    "description": "Integration test suite for the Carpooling Profile Service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Create Profile",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Extract and save userId\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.userId).to.not.be.undefined;",
              "    pm.collectionVariables.set(\"userId\", jsonData.userId);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"userId\": \"{{$guid}}\",\n    \"firstName\": \"Simon\",\n    \"lastName\": \"Schwitz\",\n    \"phoneNumber\": \"+4912345678\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/profiles",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "profiles"
          ]
        }
      }
    },
    {
      "name": "2. Get Profile",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Profile matches creation data\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.firstName).to.eql(\"Simon\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/profiles/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "profiles",
            "{{userId}}"
          ]
        }
      }
    },
    {
      "name": "3. Update Profile",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Profile name updated successfully\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.firstName).to.eql(\"Paulius\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"firstName\": \"Paulius\",\n    \"lastName\": \"Sabanskis\",\n    \"phoneNumber\": \"+3701234567\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/profiles/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "profiles",
            "{{userId}}"
          ]
        }
      }
    },
    {
      "name": "4. Add Vehicle",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Vehicle is initially unverified\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.isVerified).to.be.false;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"make\": \"Tesla\",\n    \"model\": \"Model 3\",\n    \"licensePlate\": \"ESI-2026\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/profiles/{{userId}}/vehicles",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "profiles",
            "{{userId}}",
            "vehicles"
          ]
        }
      }
    },
    {
      "name": "5. Get All Vehicles",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Returns list of vehicles\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"array\").that.is.not.empty;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/profiles/{{userId}}/vehicles",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "profiles",
            "{{userId}}",
            "vehicles"
          ]
        }
      }
    },
    {
      "name": "6. Get Verified Vehicles",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Unverified vehicle does not appear in verified list\", function () {",
              "    var jsonData = pm.response.json();",
              "    // Since we just added an unverified vehicle, this list should be empty",
              "    pm.expect(jsonData).to.be.an(\"array\").that.is.empty;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/profiles/{{userId}}/vehicles/verified",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "profiles",
            "{{userId}}",
            "vehicles",
            "verified"
          ]
        }
      }
    },
    {
      "name": "7. Update Driver Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Driver status updated to PENDING\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.driverStatus).to.eql(\"PENDING\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"driverStatus\": \"PENDING\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/profiles/{{userId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "profiles",
            "{{userId}}",
            "status"
          ]
        }
      }
    }
  ]
}