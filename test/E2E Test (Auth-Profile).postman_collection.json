{
  "info": {
    "name": "ESI End-to-End Event-Driven API (Auth + Profile)",
    "description": "Automated E2E suite. Includes dynamic variable state, token invalidation failsafes, 'sub' claim extraction, a 3-second Kafka delay, and negative testing for duplicate profiles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "authBaseUrl",
      "value": "http://localhost:8086",
      "type": "string"
    },
    {
      "key": "profileBaseUrl",
      "value": "http://localhost:8085",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "test_email",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth Service",
      "description": "Auth endpoints and JWT generation.",
      "item": [
        {
          "name": "1. Register User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate a random email once and save it to the collection",
                  "var randomNum = Math.floor(Math.random() * 100000);",
                  "pm.collectionVariables.set(\"test_email\", \"postman_e2e_\" + randomNum + \"@example.com\");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    ",
                  "    if (jsonData.token) {",
                  "        pm.collectionVariables.set(\"jwt_token\", jsonData.token);",
                  "        ",
                  "        try {",
                  "            var payload = JSON.parse(atob(jsonData.token.split('.')[1]));",
                  "            if (payload.sub) { ",
                  "                pm.collectionVariables.set(\"userId\", payload.sub); ",
                  "                console.log(\"Successfully extracted User ID: \" + payload.sub);",
                  "            } else {",
                  "                console.log(\"WARNING: No 'sub' claim found in the token!\");",
                  "            }",
                  "        } catch (e) { ",
                  "            console.log(\"Could not decode JWT\"); ",
                  "        }",
                  "    }",
                  "} else {",
                  "    pm.collectionVariables.unset(\"jwt_token\");",
                  "    pm.collectionVariables.unset(\"userId\");",
                  "    console.log(\"Auth failed. Old session wiped.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"postman123\",\n  \"roles\": [\"DRIVER\"]\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/api/auth/register",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "2. Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    ",
                  "    if (jsonData.token) {",
                  "        pm.collectionVariables.set(\"jwt_token\", jsonData.token);",
                  "        ",
                  "        try {",
                  "            var payload = JSON.parse(atob(jsonData.token.split('.')[1]));",
                  "            if (payload.sub) { ",
                  "                pm.collectionVariables.set(\"userId\", payload.sub); ",
                  "                console.log(\"Successfully extracted User ID: \" + payload.sub);",
                  "            } else {",
                  "                console.log(\"WARNING: No 'sub' claim found in the token!\");",
                  "            }",
                  "        } catch (e) { ",
                  "            console.log(\"Could not decode JWT\"); ",
                  "        }",
                  "    }",
                  "} else {",
                  "    pm.collectionVariables.unset(\"jwt_token\");",
                  "    pm.collectionVariables.unset(\"userId\");",
                  "    console.log(\"Auth failed. Old session wiped.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"postman123\"\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/api/auth/login",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "3. Validate Token",
