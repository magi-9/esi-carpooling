{
  "info": {
    "name": "ESI End-to-End Microservices API (Auth + Profile)",
    "description": "Unified integration test suite covering 100% of the documented Auth and Profile endpoints, with fixed variable states, token invalidation, and 'sub' claim extraction.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "authBaseUrl",
      "value": "http://localhost:8086",
      "type": "string"
    },
    {
      "key": "profileBaseUrl",
      "value": "http://localhost:8085",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "test_email",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth Service",
      "description": "All 7 endpoints from the Auth Service specification",
      "item": [
        {
          "name": "1. Register User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate a random email once and save it to the collection",
                  "var randomNum = Math.floor(Math.random() * 100000);",
                  "pm.collectionVariables.set(\"test_email\", \"postman_e2e_\" + randomNum + \"@example.com\");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    ",
                  "    if (jsonData.token) {",
                  "        // 1. Save the token",
                  "        pm.collectionVariables.set(\"jwt_token\", jsonData.token);",
                  "        ",
                  "        try {",
                  "            // 2. Decode the middle part of the JWT (the payload)",
                  "            var payload = JSON.parse(atob(jsonData.token.split('.')[1]));",
                  "            ",
                  "            // 3. Extract the 'sub' claim and save it as the userId",
                  "            if (payload.sub) { ",
                  "                pm.collectionVariables.set(\"userId\", payload.sub); ",
                  "                console.log(\"Successfully extracted User ID: \" + payload.sub);",
                  "            } else {",
                  "                console.log(\"WARNING: No 'sub' claim found in the token!\");",
                  "            }",
                  "        } catch (e) { ",
                  "            console.log(\"Could not decode JWT\"); ",
                  "        }",
                  "    }",
                  "} else {",
                  "    // Failsafe: Wipe old credentials if auth fails",
                  "    pm.collectionVariables.unset(\"jwt_token\");",
                  "    pm.collectionVariables.unset(\"userId\");",
                  "    console.log(\"Auth failed. Old session wiped.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"postman123\",\n  \"roles\": [\"DRIVER\"]\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/api/auth/register",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "2. Login User",
