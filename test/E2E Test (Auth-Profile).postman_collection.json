{
  "info": {
    "name": "ESI End-to-End Microservices API",
    "description": "Unified integration test suite combining Auth and Profile services with separate base URLs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "authBaseUrl",
      "value": "http://localhost:8086",
      "type": "string"
    },
    {
      "key": "profileBaseUrl",
      "value": "http://localhost:8085",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth Service",
      "description": "Endpoints from the Auth Service baseline",
      "item": [
        {
          "name": "1. Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.token) {",
                  "        pm.collectionVariables.set(\"jwt_token\", jsonData.token);",
                  "        // Decode JWT to extract userId for the Profile Service",
                  "        try {",
                  "            var payload = JSON.parse(atob(jsonData.token.split('.')[1]));",
                  "            if(payload.sub) { pm.collectionVariables.set(\"userId\", payload.sub); }",
                  "        } catch (e) { console.log(\"Could not decode JWT\"); }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman_test@example.com\",\n  \"password\": \"postman123\",\n  \"roles\": [\"DRIVER\"]\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/api/auth/register",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "2. Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.token) {",
                  "        pm.collectionVariables.set(\"jwt_token\", jsonData.token);",
                  "        try {",
                  "            var payload = JSON.parse(atob(jsonData.token.split('.')[1]));",
                  "            if(payload.sub) { pm.collectionVariables.set(\"userId\", payload.sub); }",
                  "        } catch (e) { console.log(\"Could not decode JWT\"); }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman_test@example.com\",\n  \"password\": \"postman123\"\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/api/auth/login",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "3. Validate Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response says Token is valid\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"Token is valid\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{authBaseUrl}}/api/auth/validate",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "validate"
              ]
            }
          }
        },
        {
          "name": "4. Get User Roles",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns an array of roles\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{authBaseUrl}}/api/auth/roles",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "roles"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Profile Service",
      "description": "Endpoints from the Profile Service baseline. Inherits JWT token automatically.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{jwt_token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "1. Create Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Extract and save userId\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.userId).to.not.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"userId\": \"{{userId}}\",\n    \"firstName\": \"Simon\",\n    \"lastName\": \"Schwitz\",\n    \"phoneNumber\": \"+4912345678\"\n}"
            },
            "url": {
              "raw": "{{profileBaseUrl}}/profiles",
              "host": [
                "{{profileBaseUrl}}"
              ],
              "path": [
                "profiles"
              ]
            }
          }
        },
        {
          "name": "2. Get Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Profile matches creation data\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.firstName).to.eql(\"Simon\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{profileBaseUrl}}/profiles/{{userId}}",
              "host": [
                "{{profileBaseUrl}}"
              ],
              "path": [
                "profiles",
                "{{userId}}"
              ]
            }
          }
        },
        {
          "name": "3. Update Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Profile name updated successfully\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.firstName).to.eql(\"Paulius\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstName\": \"Paulius\",\n    \"lastName\": \"Sabanskis\",\n    \"phoneNumber\": \"+3701234567\"\n}"
            },
            "url": {
              "raw": "{{profileBaseUrl}}/profiles/{{userId}}",
              "host": [
                "{{profileBaseUrl}}"
              ],
              "path": [
                "profiles",
                "{{userId}}"
              ]
            }
          }
        },
        {
          "name": "4. Add Vehicle",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Vehicle is initially unverified\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.isVerified).to.be.false;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"make\": \"Tesla\",\n    \"model\": \"Model 3\",\n    \"licensePlate\": \"ESI-2026\"\n}"
            },
            "url": {
              "raw": "{{profileBaseUrl}}/profiles/{{userId}}/vehicles",
              "host": [
                "{{profileBaseUrl}}"
              ],
              "path": [
                "profiles",
                "{{userId}}",
                "vehicles"
              ]
            }
          }
        },
        {
          "name": "5. Get All Vehicles",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Returns list of vehicles\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"array\").that.is.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{profileBaseUrl}}/profiles/{{userId}}/vehicles",
              "host": [
                "{{profileBaseUrl}}"
              ],
              "path": [
                "profiles",
                "{{userId}}",
                "vehicles"
              ]
            }
          }
        },
        {
          "name": "6. Get Verified Vehicles",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Unverified vehicle does not appear in verified list\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"array\").that.is.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{profileBaseUrl}}/profiles/{{userId}}/vehicles/verified",
              "host": [
                "{{profileBaseUrl}}"
              ],
              "path": [
                "profiles",
                "{{userId}}",
                "vehicles",
                "verified"
              ]
            }
          }
        },
        {
          "name": "7. Update Driver Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Driver status updated to PENDING\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.driverStatus).to.eql(\"PENDING\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"driverStatus\": \"PENDING\"\n}"
            },
            "url": {
              "raw": "{{profileBaseUrl}}/profiles/{{userId}}/status",
              "host": [
                "{{profileBaseUrl}}"
              ],
              "path": [
                "profiles",
                "{{userId}}",
                "status"
              ]
            }
          }
        }
      ]
    }
  ]
}